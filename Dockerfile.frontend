FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY angular.json ./
COPY tsconfig.json ./
COPY tsconfig.app.json ./
COPY src ./src
COPY public ./public

RUN npm run build -- --configuration production
RUN set -eux; BROWSER_DIR="$(find dist -type d -name browser | head -n 1)"; mkdir -p /app/frontend-dist; cp -r "${BROWSER_DIR}"/. /app/frontend-dist/

FROM nginx:1.27-alpine

COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/frontend-dist /usr/share/nginx/html

EXPOSE 80
