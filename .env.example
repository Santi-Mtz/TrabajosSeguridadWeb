# Shared defaults for local development

# API Gateway
PORT=3000
USER_SERVICE_URL=http://localhost:3001
GROUP_SERVICE_URL=http://localhost:3003
TICKET_SERVICE_URL=http://localhost:3002
JWT_SECRET=change-me
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
DATABASE_URL=postgresql://postgres:password@localhost:5432/seguridad_web
DATABASE_SSL=false
OBSERVABILITY_ENABLED=true

# User service
USER_SERVICE_PORT=3001
USER_DATABASE_URL=postgresql://postgres:password@localhost:5432/seguridad_web
USER_DATABASE_SSL=false

# Ticket service
TICKET_SERVICE_PORT=3002
TICKET_DATABASE_URL=postgresql://postgres:password@localhost:5432/seguridad_web
TICKET_DATABASE_SSL=false

# Group service
GROUP_SERVICE_PORT=3003
GROUP_DATABASE_URL=postgresql://postgres:password@localhost:5432/seguridad_web
GROUP_DATABASE_SSL=false
